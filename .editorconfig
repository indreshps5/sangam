# EditorConfig - https://editorconfig.org
# Enforces consistent coding styles across editors and IDEs

root = true

# Default settings for all files
[*]
end_of_line = crlf
insert_final_newline = true
charset = utf-8
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# Python files
[*.py]
indent_size = 4
max_line_length = 100

# Markdown files
[*.md]
trim_trailing_whitespace = false

# YAML files
[*.{yml,yaml}]
indent_size = 2

# JSON files
[*.json]
indent_size = 2

# Shell scripts
[*.sh]
end_of_line = lf
indent_size = 2

# Makefiles (must use tabs)
[Makefile]
indent_style = tab

# SQL files
[*.sql]
indent_size = 2

# Docker files
[Dockerfile*]
indent_size = 4

# Git configuration
[*.gitattributes]
end_of_line = lf
